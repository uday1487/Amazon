pipeline {

    agent any

    stages {

        stage('Amazon Build') {
            steps {
                dir('Amazon') {
                    sh 'mvn clean install'
                }
            }
        }

        stage('SKY Build') {
            steps {
                dir('SKY') {
                    sh 'mvn clean install'
                }
            }
        }

        stage('SpringCore Build') {
            steps {
                dir('SpringCore') {
                    sh 'mvn clean install'
                }
            }
        }

        stage('Success') {
            steps {
                echo 'All projects installed successfully'
            }
        }
    }
}
