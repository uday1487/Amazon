@Library('SharedJenkinsLibrary') _

pipeline {

    agent any

    stages {

        stage('Welcome') {
            steps {
                hello('Amazon Project')
            }
        }

        stage('Git Checkout') {
            steps {
                echo 'Amazon source code checked out'
            }
        }

        stage('Maven Build') {
            steps {
                dir('Amazon') {
                    mavenBuild()
                }
            }
        }

        stage('Maven Test') {
            steps {
                dir('Amazon') {
                    mavenTest()
                }
            }
        }

        stage('Success') {
            steps {
                echo 'Amazon Pipeline Completed Successfully'
            }
        }
    }
}
